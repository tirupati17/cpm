# The memory this tool produces belongs to whoever runs it, never to the repo.
#
# This is the line that keeps a fork from publishing its own workspace by
# accident: changelogs, summaries, plans and reports are generated locally and
# describe private work. The tool ships; the memory does not.
memory/
TRUTH.md

# Local state written by the installer and the health check.
.cpm-initialized
.cpm-user.conf
.cpm-install.conf

# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/
node_modules/
__pycache__/

# Skill links are rebuilt from skills/ by setup.sh and cpm-check.sh.
.claude/skills/
.agents/skills/

# Credentials never live in the workspace; the toolkit keeps them in
# ~/.config/cpm/<project>/. These catch the usual accidents anyway.
keys/
*.p8
*service-account*.json
credentials.env
.env
.env.*
